# =================================================================
# Environment Variables — Wiki Docs
# =================================================================
# Copy ke .env.local. Jangan commit .env.local.

# =================================================================
# Database (PostgreSQL) — wajib untuk login
# =================================================================
DATABASE_URL=postgresql://wiki:wiki@localhost:5432/wiki?schema=public

# =================================================================
# NextAuth
# =================================================================
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Secret internal untuk POST /api/login-log (opsional, default NEXTAUTH_SECRET)
# LOGIN_LOG_INTERNAL_SECRET=

# =================================================================
# Seed admin pertama (npm run db:seed)
# =================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Administrator
# SEED_RESET_ADMIN_PASSWORD=false

# =================================================================
# Opsional — AI enhance (editor)
# =================================================================
# AI_ENHANCE_ORDER=openai,gemini,ollama
# OPENAI_API_KEY=
# OPENAI_AI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_AI_MODEL=gemini-2.0-flash-exp
# OLLAMA_API_KEY=
# OLLAMA_API_ENDPOINT=http://localhost:11434
# OLLAMA_AI_MODEL=llama3.2

# =================================================================
# Runtime
# =================================================================
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
TIMEZONE=Asia/Jakarta
