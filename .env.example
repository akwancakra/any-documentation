# =================================================================
# Environment Variables — Any Documentation
# =================================================================
# Copy ke .env.local. Jangan commit .env.local.

# =================================================================
# Database (PostgreSQL) — wajib untuk login
# =================================================================
DATABASE_URL=postgresql://wiki:wiki@localhost:5432/wiki?schema=public

# =================================================================
# NextAuth
# =================================================================
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000
# URL publik untuk metadata OG (metadataBase). Di produksi biasanya sama dengan NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://docs.example.com

# Secret internal untuk POST /api/login-log (opsional, default NEXTAUTH_SECRET)
# LOGIN_LOG_INTERNAL_SECRET=

# =================================================================
# Seed admin pertama (npm run db:seed)
# =================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Administrator
# SEED_RESET_ADMIN_PASSWORD=false

# =================================================================
# Opsional — AI enhance (editor)
# =================================================================
# AI_ENHANCE_ORDER=openai,gemini,ollama
# OPENAI_API_KEY=
# OPENAI_AI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_AI_MODEL=gemini-2.0-flash-exp
# OLLAMA_API_KEY=
# OLLAMA_API_ENDPOINT=http://localhost:11434
# OLLAMA_AI_MODEL=llama3.2

# =================================================================
# Penyimpanan dokumen MDX (content/docs)
# =================================================================
# fs = baca/tulis ke folder content/docs di disk (default lokal / container)
# s3 = Amazon S3 (butuh bucket + IAM; cocok untuk ECS multi-instance)
# DOCS_STORAGE=fs
# DOCS_STORAGE=s3
# DOCS_S3_BUCKET=your-bucket-name
# Prefix object di bucket (opsional), mis. wiki-docs/
# DOCS_S3_PREFIX=
# AWS_REGION=ap-southeast-1

# =================================================================
# Runtime
# =================================================================
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
TIMEZONE=Asia/Jakarta
