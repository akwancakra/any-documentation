# =================================================================
# Environment Variables Template — Any Documentation
# =================================================================
# Copy ke .env.local dan isi nilai yang sesuai. Jangan commit .env.local.

# =================================================================
# Database (PostgreSQL) — wajib untuk login
# =================================================================
# Contoh lokal:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wiki?schema=public"
DATABASE_URL=postgresql://wiki:wiki@localhost:5432/wiki?schema=public

# =================================================================
# NextAuth
# =================================================================
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000
# URL publik situs (metadata OG / metadataBase). Di VPS biasanya sama dengan NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://docs.example.com

# Secret internal untuk POST /api/login-log dari server (opsional, default NEXTAUTH_SECRET)
# LOGIN_LOG_INTERNAL_SECRET=

# =================================================================
# Seed akun demo (npm run db:seed) — admin + user biasa
# =================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_NAME=Administrator
# Set true untuk reset password admin saat seed ulang
# SEED_RESET_ADMIN_PASSWORD=false

SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=password123
SEED_USER_NAME=Demo User
# Set true untuk reset password user demo saat seed ulang
# SEED_RESET_USER_PASSWORD=false

# =================================================================
# Opsional — AI enhance (/api/ai-enhance, editor split view)
# =================================================================
# Urutan provider: openai,gemini,ollama (yang punya API key dipakai; fallback ke berikutnya)
# AI_ENHANCE_ORDER=openai,gemini,ollama
#
# OPENAI_API_KEY=
# OPENAI_AI_MODEL=gpt-4o-mini
#
# GEMINI_API_KEY=
# GEMINI_AI_MODEL=gemini-2.0-flash-exp
#
# OLLAMA_API_KEY=
# OLLAMA_API_ENDPOINT=http://localhost:11434
# OLLAMA_AI_MODEL=llama3.2

# =================================================================
# Runtime
# =================================================================
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
TIMEZONE=Asia/Jakarta

# =================================================================
# Setup singkat
# =================================================================
# 1. cp env.template .env.local
# 2. Jalankan PostgreSQL (mis. docker compose --profile with-postgres up -d)
# 3. npm install
# 4. npm run db:migrate   atau   npm run db:push
# 5. npm run db:seed
# 6. npm run dev
# =================================================================
