# =================================================================
# Environment variables template — Any Documentation
# =================================================================
# Copy to .env.local and fill in appropriate values. Do not commit .env.local.

# =================================================================
# Database (PostgreSQL) — required for login
# =================================================================
# Local example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wiki?schema=public"
DATABASE_URL=postgresql://wiki:wiki@localhost:5432/wiki?schema=public

# =================================================================
# NextAuth
# =================================================================
NEXTAUTH_SECRET=your-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000
# Public site URL (OG metadata / metadataBase). On a VPS usually matches NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://docs.example.com

# Internal secret for POST /api/login-log from trusted callers (optional; defaults to NEXTAUTH_SECRET)
# LOGIN_LOG_INTERNAL_SECRET=

# =================================================================
# Demo accounts (npm run db:seed) — admin + regular user
# =================================================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_NAME=Administrator
# Set true to reset admin password when re-running seed
# SEED_RESET_ADMIN_PASSWORD=false

SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=password123
SEED_USER_NAME=Demo User
# Set true to reset demo user password when re-running seed
# SEED_RESET_USER_PASSWORD=false

# =================================================================
# Optional — AI enhance (/api/ai-enhance, split editor)
# =================================================================
# Provider order: openai,gemini,ollama (first available API key wins; falls through)
# AI_ENHANCE_ORDER=openai,gemini,ollama
#
# OPENAI_API_KEY=
# OPENAI_AI_MODEL=gpt-4o-mini
#
# GEMINI_API_KEY=
# GEMINI_AI_MODEL=gemini-2.0-flash-exp
#
# OLLAMA_API_KEY=
# OLLAMA_API_ENDPOINT=http://localhost:11434
# OLLAMA_AI_MODEL=llama3.2

# =================================================================
# Runtime
# =================================================================
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
TIMEZONE=Asia/Jakarta

# =================================================================
# Quick start checklist
# =================================================================
# 1. cp env.template .env.local
# 2. Start PostgreSQL (e.g. docker compose --profile with-postgres up -d)
# 3. npm install
# 4. npm run db:migrate   or   npm run db:push
# 5. npm run db:seed
# 6. npm run dev
# =================================================================
